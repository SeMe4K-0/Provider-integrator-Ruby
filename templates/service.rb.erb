# frozen_string_literal: true

require "json"
require "openssl"

# Сервис сгенерирован из спецификации "<%= spec_title %>" (версия <%= spec_version %>).
# Правки вносите в спецификацию или в config/rules/*.yml и перегенерируйте файл.
class Provider
  class <%= class_name %> < BaseService
    BASE_URL = ENV.fetch("<%= env_var_name %>", "<%= default_base_url %>")
<% if signature -%>

    # Заголовок с подписью входящего уведомления
<% unless signature.confirmed -%>
    # TODO: алгоритм подписи не указан в спецификации явно, принят HMAC-<%= signature.algorithm %>/<%= signature.encoding %> — подтвердите у провайдера
<% end -%>
    SIGNATURE_HEADER = "<%= signature.header_name %>"
<% end -%>
<% if min_amount -%>

    # Минимальная сумма операции, из ограничения minimum в спецификации
    MIN_AMOUNT = <%= min_amount %>
<% end -%>

    # Статусы провайдера → статусы Space Payments
    STATUS_MAP = {
<% status_map.each do |provider_status, canonical| -%>
      "<%= provider_status %>" => "<%= canonical %>",
<% end -%>
<% unresolved_statuses.each do |status| -%>
      # TODO: статус "<%= status %>" не сопоставлен, добавьте синоним в config/rules/statuses.yml
<% end -%>
<% if status_map.empty? -%>
      # TODO: в спецификации не найден перечень статусов операции — заполните таблицу вручную
<% end -%>
    }.freeze

    # HTTP-коды провайдера → внутренние коды ошибок и действия
    ERROR_MAP = {
<% error_map.each do |code, rule| -%>
      <%= code %> => { code: "<%= rule[:code] %>", action: "<%= rule[:action] %>" },
<% end -%>
<% if error_map.empty? -%>
      # TODO: в спецификации не описаны ответы с кодами 4xx/5xx — заполните таблицу вручную
<% end -%>
    }.freeze

    # HTTP-код провайдера в статус результата Space Payments
    HTTP_STATUS_MAP = {
      400 => :bad_request,
      401 => :unauthorized,
      402 => :payment_required,
      403 => :forbidden,
      404 => :not_found,
      409 => :conflict,
      422 => :unprocessable_entity,
      429 => :too_many_requests,
      500 => :internal_server_error,
      502 => :bad_gateway,
      503 => :service_unavailable,
      504 => :gateway_timeout
    }.freeze

<% if min_amount -%>
    def check_conditions(operation, request_method = "create")
      base_result = super
      return base_result if base_result.failed?
      return failure(:unprocessable_entity, "amount_too_low") if operation.amount < MIN_AMOUNT

      success
    end

<% end -%>
<% if create_path -%>
    def create_request(operation, request_method = "create")
      response = client.post(url_for("<%= create_path %>"), json: build_payload(operation), headers: create_headers(operation))
      parse_create_response(operation, response)
    rescue Provider::RateLimitError
      failure(:too_many_requests, "provider.rate_limit")
    rescue Provider::UnauthorizedError
      failure(:unauthorized, "provider.invalid_credentials")
    end

<% end -%>
<% if status_path -%>
    def fetch_status(operation)
      response = client.get(url_for("<%= status_path %>"), headers: auth_headers)
      return failure(*error_for(response.code)) unless response.success?
      return failure(:unprocessable_entity, "provider.malformed_response") unless response.body.is_a?(Hash)

      map_status(response.body["<%= status_field %>"])
    rescue Provider::RateLimitError
      failure(:too_many_requests, "provider.rate_limit")
    rescue Provider::UnauthorizedError
      failure(:unauthorized, "provider.invalid_credentials")
    end

<% end -%>
<% if cancel_path -%>
    def cancel_request(operation)
      response = client.post(url_for("<%= cancel_path %>"), json: {}, headers: auth_headers)
      return failure(*error_for(response.code)) unless response.success?
      return failure(:unprocessable_entity, "provider.malformed_response") unless response.body.is_a?(Hash)

      map_status(response.body["<%= status_field %>"])
    end

<% end -%>
<% if webhook_endpoint -%>
    # Обработка входящего уведомления по контракту платформы: один аргумент.
    # Тело уведомления, сырое тело и заголовки платформа передаёт в одном
    # объекте payload (см. раздел "Формат уведомления" в INTEGRATION.md).
<% if signature -%>
    # Подпись обязательна: неподписанное уведомление отклоняется, даже если
    # тело выглядит корректным.
<% end -%>
    def process_callback(payload)
      body = callback_body(payload)
<% if signature -%>
      return failure(:unauthorized, "provider.missing_signature") if callback_signature(payload).nil?
      return failure(:unprocessable_entity, "provider.raw_body_required") if callback_raw_body(payload).nil?
      return failure(:unauthorized, "provider.invalid_signature") unless valid_signature?(payload)

<% end -%>
      provider_operation_id = body["<%= webhook_id_field %>"]
      status = body["<%= status_field %>"] || body["event"].to_s.split(".").last

      case STATUS_MAP[status.to_s]
      when "approved" then approve_operation(provider_operation_id)
      when "rejected" then reject_operation(provider_operation_id, body.dig("error", "code"))
      when "in_progress" then progress_operation(provider_operation_id)
      else failure(:unprocessable_entity, "provider.unknown_status")
      end
    end

<% end -%>
    private

    # Базовый адрес API; переопределяется через переменную окружения для стендов и тестов
    def base_url
      ENV.fetch("<%= env_var_name %>", BASE_URL)
    end

    # Адрес запроса<% if auth_query_parameter %> с добавленным ключом авторизации<% end %>
    def url_for(path)
<% if auth_query_parameter -%>
      with_auth_query("#{base_url}#{path}")
<% else -%>
      "#{base_url}#{path}"
<% end -%>
    end

    # Заголовки авторизации: <%= auth_comment %>
<% if unsupported_auth -%>
    # TODO: схема <%= unsupported_auth %> генератором не поддержана — заполните заголовки вручную,
    # иначе запросы уйдут без авторизации
<% end -%>
    def auth_headers
      <%= auth_headers_expression %>
    end
<% if auth_query_parameter -%>

    # Ключ передаётся параметром запроса, а не заголовком
    def with_auth_query(url)
      separator = url.include?("?") ? "&" : "?"
      "#{url}#{separator}<%= auth_query_parameter %>=#{credentials.fetch(:api_key)}"
    end
<% end -%>
<% if create_path -%>

    # Заголовки запроса на создание операции
<% if idempotency_header_name -%>
    # Ключ идемпотентности берётся из идентификатора операции: повторная отправка
    # того же запроса не создаст у провайдера вторую выплату
<% end -%>
<% required_header_params.each do |parameter| -%>
    # TODO: провайдер требует заголовок <%= parameter.name %> (<%= parameter.description || 'описание не задано' %>) — задайте значение
<% end -%>
    def create_headers(operation)
      auth_headers<% if idempotency_header_name %>.merge("<%= idempotency_header_name %>" => operation.id.to_s)<% end %>
    end
<% end -%>

<% payload_todos.each do |todo| -%>
    # TODO: <%= todo %>
<% end -%>
    # Незаполненные реквизиты отбрасываются: провайдеру не отправляются поля со значением nil
    def build_payload(operation)
      {
<%= payload_source %>
      }.compact
    end

    def parse_create_response(operation, response)
      # Повтор с тем же ключом идемпотентности возвращает уже созданную
      # операцию, а не ошибку: её нужно принять, а не отклонить
      return parse_duplicate(operation, response) if error_action(response.code) == "fetch_status"
      return failure(*error_for(response.code)) unless response.success?
      return failure(:unprocessable_entity, "provider.malformed_response") unless response.body.is_a?(Hash)

      operation.provider_operation_id = response.body["<%= provider_id_field %>"]
      map_status(response.body["<%= status_field %>"])
    end
<% if webhook_endpoint -%>

    # Платформа может передать тело уведомления как есть или в конверте
    # с ключами "body", "raw_body" и "headers"
    def callback_body(payload)
      payload["body"].is_a?(Hash) ? payload["body"] : payload
    end
<% if signature -%>

    def callback_signature(payload)
      headers = payload["headers"]
      return payload["signature"] unless headers.is_a?(Hash)

      headers[SIGNATURE_HEADER] || headers[SIGNATURE_HEADER.downcase]
    end

    # Подпись считается от сырого тела запроса байт в байт: пересобранный JSON
    # не совпадёт с исходным по порядку ключей и экранированию, поэтому
    # уведомление без сырого тела не принимается
    def callback_raw_body(payload)
      payload["raw_body"]
    end
<% end -%>
<% end -%>

    # Статус провайдера в статус Space Payments; неизвестное значение не угадывается
    def map_status(provider_status)
      canonical = STATUS_MAP[provider_status.to_s]
      return failure(:unprocessable_entity, "provider.unknown_status") if canonical.nil?

      success(status: canonical)
    end

    # HTTP-код провайдера в статус Space Payments и внутренний код ошибки.
    # Действие (retry / retry_backoff / alert_*) берётся из ERROR_MAP вызывающей
    # стороной — оно определяет, повторять ли операцию.
    def error_for(http_code)
      rule = ERROR_MAP[http_code] || { code: "internal_error", action: "alert_and_retry" }
      [HTTP_STATUS_MAP.fetch(http_code, :unprocessable_entity), "provider.#{rule[:code]}"]
    end

    def error_action(http_code)
      ERROR_MAP.dig(http_code, :action) || "alert_and_retry"
    end

    def parse_duplicate(operation, response)
      return failure(:conflict, "provider.duplicate_request") unless response.body.is_a?(Hash)

      operation.provider_operation_id = response.body["<%= provider_id_field %>"]
      map_status(response.body["<%= status_field %>"])
    end
<% if signature -%>

    # Подпись тела запроса: HMAC-<%= signature.algorithm %>, кодировка <%= signature.encoding %>
    def valid_signature?(payload)
      raw_body = callback_raw_body(payload)
<% if signature.encoding == "base64" -%>
      digest = OpenSSL::HMAC.digest("<%= signature.algorithm %>", credentials.fetch(:callback_secret), raw_body)
      expected = [digest].pack("m0")
<% else -%>
      expected = OpenSSL::HMAC.hexdigest("<%= signature.algorithm %>", credentials.fetch(:callback_secret), raw_body)
<% end -%>
      OpenSSL.secure_compare(expected, callback_signature(payload).to_s)
    end
<% end -%>
  end
end
