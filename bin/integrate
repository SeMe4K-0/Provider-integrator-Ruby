#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/provider_integrator/spec_loader"
require_relative "../lib/provider_integrator/semantic_analyzer"
require_relative "../lib/provider_integrator/data_mapper"

options = { spec: nil }

OptionParser.new do |parser|
  parser.banner = "Использование: bin/integrate --spec PATH [--provider NAME] [--lang ruby]"
  parser.on("--spec PATH", "Путь к файлу спецификации OpenAPI") { |v| options[:spec] = v }
  parser.on("--provider NAME", "Имя провайдера (для будущих частей генератора)") { |v| options[:provider] = v }
  parser.on("--lang LANG", "Целевой язык генерации (сейчас поддерживается только ruby)") { |v| options[:lang] = v }
end.parse!(ARGV)

unless options[:spec]
  warn "Не указан обязательный параметр --spec"
  exit 1
end

puts "Parsing spec..."

begin
  spec = ProviderIntegrator::SpecLoader.load(options[:spec])
rescue ProviderIntegrator::SpecLoadError => e
  warn "Ошибка разбора спецификации: #{e.message}"
  exit 1
end

analysis = ProviderIntegrator::SemanticAnalyzer.analyze(spec)

endpoint_list = analysis.endpoints.map(&:to_s).join(", ")
puts "Found #{analysis.endpoints.size} endpoints: #{endpoint_list}"

if spec.security_schemes.empty?
  puts "Auth: не задана"
else
  spec.security_schemes.each_value do |scheme|
    detail = scheme.type == "apiKey" ? "(header: #{scheme.header_name})" : "(#{scheme.scheme})"
    puts "Auth: #{scheme.name} #{detail}"
  end
end

if analysis.webhook_found
  source = { path: "путь в paths", webhooks_section: "раздел webhooks:" }[analysis.webhook_source]
  puts "Webhook: найден (#{source})"
else
  puts "Webhook: не найден"
end

ROLE_LABELS = {
  create: "создание", status: "статус", cancel: "отмена", webhook: "webhook", other: "прочее"
}.freeze

puts "\nРоли эндпоинтов:"
analysis.endpoints.each { |e| puts "  #{e} → #{ROLE_LABELS[e.role]}" }

report = ProviderIntegrator::DataMapper.map(spec, analysis)
puts "\nСопоставление данных:"
report.entries.each do |entry|
  icon = entry.status == :resolved ? "✅" : "⚠️"
  puts "  #{icon} [#{entry.category}] #{entry.key} #{entry.detail}"
end
puts "\nИтого: #{report.resolved.size} распознано, #{report.unresolved.size} требует правил"
