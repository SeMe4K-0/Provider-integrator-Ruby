#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/provider_integrator/pipeline"

ROLE_LABELS = {
  create: "создание", status: "статус", cancel: "отмена", webhook: "webhook", other: "прочее"
}.freeze

options = { lang: "ruby", output: File.expand_path("../output", __dir__) }

PROVIDER_NAME_FORMAT = /\A[a-z][a-z0-9_]*\z/

begin
  OptionParser.new do |parser|
    parser.banner = "Использование: bin/integrate --spec PATH [--provider NAME] [--lang ruby] [--output DIR]"
    parser.on("--spec PATH", "Путь к файлу спецификации OpenAPI") { |v| options[:spec] = v }
    parser.on("--provider NAME", "Имя провайдера (используется в имени класса и файлов)") { |v| options[:provider] = v }
    parser.on("--lang LANG", "Целевой язык генерации (поддерживается ruby)") { |v| options[:lang] = v }
    parser.on("--output DIR", "Каталог для результата генерации") { |v| options[:output] = v }
    parser.on("--dry-run", "Только разобрать спецификацию и показать отчёт, файлы не создавать") { options[:dry_run] = true }
  end.parse!(ARGV)
rescue OptionParser::ParseError => e
  warn "Ошибка в аргументах: #{e.message}"
  warn "Запустите bin/integrate --help, чтобы увидеть список параметров"
  exit 1
end

unless options[:spec]
  warn "Не указан обязательный параметр --spec"
  exit 1
end

unless options[:lang] == "ruby"
  warn "Язык \"#{options[:lang]}\" не поддерживается, доступен только ruby"
  exit 1
end

# Имя провайдера по умолчанию берётся из имени файла спецификации. Оно попадает
# в имя класса и в путь файла, поэтому проверяется до начала работы: иначе
# генератор отрапортует успех, создав файл с невалидным Ruby внутри.
provider = (options[:provider] || File.basename(options[:spec].to_s, ".*").split(/[_\-\s]/).first).to_s.downcase

unless provider.match?(PROVIDER_NAME_FORMAT)
  warn "Недопустимое имя провайдера: #{provider.inspect}"
  warn "Ожидается имя из латинских букв, цифр и подчёркиваний, начинающееся с буквы, например: novapay"
  exit 1
end

puts "Parsing spec..."

begin
  pipeline = ProviderIntegrator::Pipeline.new(
    spec_path: options[:spec],
    provider: provider,
    output_dir: options[:output]
  )
  result = options[:dry_run] ? pipeline.analyze_only : pipeline.run
rescue ProviderIntegrator::SpecLoadError => e
  warn "Ошибка разбора спецификации: #{e.message}"
  exit 1
rescue ProviderIntegrator::GenerationError => e
  warn "Ошибка генерации: #{e.message}"
  exit 1
end

analysis = result.analysis
report = result.mapping.report

puts "Found #{analysis.endpoints.size} endpoints: #{analysis.endpoints.map(&:to_s).join(', ')}"

if result.spec.security_schemes.empty?
  puts "Auth: не задана"
else
  result.spec.security_schemes.each_value do |scheme|
    detail = case scheme.type
             when "apiKey" then "(#{scheme.location == 'query' ? 'query' : 'header'}: #{scheme.header_name})"
             when "http" then "(#{scheme.scheme})"
             else "(#{scheme.type} — заголовки авторизации не генерируются)"
             end
    puts "Auth: #{scheme.name} #{detail}"
  end
end

if analysis.webhook_found
  source = {
    path: "путь в paths",
    webhooks_section: "раздел webhooks:",
    heuristic: "косвенный признак, требует проверки"
  }[analysis.webhook_source]
  signature = result.mapping.signature
  suffix = signature ? ", подпись #{signature.header_name} (HMAC-#{signature.algorithm}/#{signature.encoding})" : ""
  puts "Webhook: найден (#{source})#{suffix}"
else
  puts "Webhook: не найден"
end

puts "\nРоли эндпоинтов:"
analysis.endpoints.each { |e| puts "  #{e} → #{ROLE_LABELS[e.role]}" }

ICONS = { resolved: "✅", unresolved: "⚠️", skipped: "·" }.freeze

puts "\nСопоставление данных:"
report.entries.each do |entry|
  puts "  #{ICONS.fetch(entry.status)} [#{entry.category}] #{entry.key} #{entry.detail}"
end
puts "\nИтого: #{report.resolved.size} распознано, #{report.unresolved.size} требует решения, " \
     "#{report.skipped.size} неприменимо к этому провайдеру"

if result.written_files
  puts "\nOutput:"
  result.written_files.each { |path| puts "  #{path}" }
end
